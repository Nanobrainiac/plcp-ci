{
  "name": "plcp-competitive-intelligence-repository",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://nanobrainiac.github.io/plcp-ci/",
  "scripts": {
    "dev": "concurrently \"npm:dev --prefix server\" \"npm:dev --prefix client\"",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",

    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "heroku-postbuild": "npm install --prefix server && npm install --prefix client && npm run build --prefix client",
    "build:pages": "npm run build --prefix client -- --base=/plcp-ci/",
    "predeploy": "npm run build:pages",
    "deploy": "gh-pages -d client/dist"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "gh-pages": "^6.3.0"
  }
}
